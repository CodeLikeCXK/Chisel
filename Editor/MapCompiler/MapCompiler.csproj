<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>net8.0</TargetFramework>
		<ImplicitUsings>disable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<PublishSelfContained>True</PublishSelfContained>
	</PropertyGroup>

	<PropertyGroup>
		<SatelliteResourceLanguages>en-US</SatelliteResourceLanguages>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
		<DefineConstants>$(DefineConstants);compiler;ENABLE_BSP</DefineConstants>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
		<DefineConstants>$(DefineConstants);ENABLE_BSP;compiler</DefineConstants>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Lovebirb.MonoGame.SkinnedMeshImporter" Version="1.0.4" />
		<PackageReference Include="Managed.System.Drawing" Version="4.1.2" />
		<PackageReference Include="MessagePack" Version="3.1.7" />
		<PackageReference Include="MessagePack.Attributeless" Version="1.0.1" />
		<PackageReference Include="MonoGame.Library.SDL" Version="2.32.10.2" />
		<PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
		<PackageReference Include="RectpackSharp" Version="1.2.0" />
		<PackageReference Include="Silk.NET.Windowing" Version="2.23.0" />
		<PackageReference Include="Silk.NET.OpenGL" Version="2.23.0" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\..\Core\MonoGame.Forked\MonoGame.Framework\MonoGame.Framework.DesktopGL.csproj" />
	</ItemGroup>

	<ItemGroup Condition="'$(RuntimeIdentifier)' != 'win-x64'">
		<None Include="..\..\Core\Engine\openal_arm64.dll" Link="runtimes\win-arm64\native\openal.dll" CopyToOutputDirectory="PreserveNewest" Visible="false" />
		<None Include="..\..\Core\Engine\openal_arm64.dll" Link="runtimes\win-arm64\native\soft_oal.dll" CopyToOutputDirectory="PreserveNewest" Visible="false" />
		<None Include="..\..\Core\Engine\assimp_arm64.dll" Link="runtimes\win-arm64\native\assimp.dll" CopyToOutputDirectory="PreserveNewest" Visible="false" />
		<None Include="..\..\Core\Engine\assimp_arm64.dll" Link="runtimes\win-arm64\native\Assimp64.dll" CopyToOutputDirectory="PreserveNewest" Visible="false" />
	</ItemGroup>

	<Import Project="..\..\Shared\ChiselSharedTypes\ChiselSharedTypes.projitems" Label="Shared" />

	<Import Project="..\..\Shared\ChiselEditorUtils\ChiselEditorUtils.projitems" Label="Shared" />

	<Import Project="..\..\Shared\ChiselModelTypes\ChiselModelTypes.projitems" Label="Shared" />

	<ItemGroup>
		<EmbeddedResource Include="Shaders\**\*.glsl" />
	</ItemGroup>

</Project>
